{
  "name": "@vovinam/launcher",
  "private": true,
  "version": "1.0.7",
  "description": "FRVV Competition Launcher - runs the full competition stack locally, syncing an event down from the cloud before the day starts and back up afterwards.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite --port 5178 --strictPort",
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm run dev:renderer\" \"wait-on tcp:5178 && cross-env ELECTRON_START_URL=http://localhost:5178 electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder -p never",
    "prebuild": "node electron/sincronizeazaNumele.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ro.frvv.launcher",
    "productName": "FRVV Competition Launcher v1.0.7",
    "artifactName": "FRVV-Competition-Launcher-${version}-${arch}.${ext}",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FRVV Competition Launcher"
    },
    "extraResources": [
      {
        "from": "../../docker-compose.venue.yml",
        "to": "docker-compose.venue.yml"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gabimolocea",
        "repo": "vovinam-admin"
      }
    ],
    "afterPack": "build/afterPack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "multicast-dns": "^7.2.5"
  }
}
