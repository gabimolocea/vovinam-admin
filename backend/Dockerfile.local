# Backend-only image for local/venue (LAN) competition-day operation.
# Frontends (competition-admin, referee-scoring, public-display) are NOT
# bundled here — they keep running via `npm run dev` / `./scripts/start-all-apps.sh`
# on the same machine (their Vite dev server already binds 0.0.0.0 and proxies
# /api to this backend), which keeps this image small and avoids rebuilding
# static bundles for every event.
#
# See docker-compose.local.yml and docs/GHID_COMPETITIE_LOCALA.md.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=crud.settings_local

WORKDIR /app

# postgresql-client-17 provides pg_dump/pg_restore, used by the backup/
# restore panel - pinned to 17 specifically (via the official PGDG apt
# repo, since Debian's own repos don't reliably ship 17) to match
# docker-compose.local.yml's postgres:17 image and production's own
# PostgreSQL version exactly, avoiding client/server version-skew issues.
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y postgresql-client-17 \
    && apt-get purge -y curl gnupg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

COPY . .

RUN mkdir -p static media local_backups

COPY entrypoint.local.sh /app/entrypoint.local.sh
RUN chmod +x /app/entrypoint.local.sh

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.local.sh"]
