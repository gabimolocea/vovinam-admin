# Copy this file to .env.local and adjust before the event, then run:
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d
#
# LAN_HOST must be the local/static IP of THIS machine on the venue Wi-Fi
# (see docs/GHID_COMPETITIE_LOCALA.md, section "Rețea"). All tablets/laptops
# in the venue will reach the backend through this address.
LAN_HOST=192.168.10.10

# Change these before a real event — the defaults are fine for a quick test.
DJANGO_SECRET_KEY=change-me-before-the-event
DB_NAME=frvv_local
DB_USER=frvv
DB_PASSWORD=frvv_local_password

# How often an automatic snapshot ("time machine" checkpoint) is taken.
LOCAL_BACKUP_INTERVAL_MINUTES=15
# How many snapshots to keep before the oldest ones are deleted.
LOCAL_BACKUP_RETENTION_COUNT=200

# OPTIONAL — only needed for the "Resincronizează din cloud" button, used to
# pull down a fresh event pack mid-event (e.g. after adding a brand-new
# athlete/category in cloud) without manually transferring a JSON file.
# Leave all three empty to disable the button (manual export/import still
# always works). Use a dedicated admin service account, not a personal login.
# CLOUD_SYNC_BASE_URL=https://your-cloud-domain.example.com
# CLOUD_SYNC_USERNAME=sync-service-account
# CLOUD_SYNC_PASSWORD=change-me
